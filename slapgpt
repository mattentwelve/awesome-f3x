--// REMOVE COLOUR CORRECTION
local function removeFiftyKillCC()
	local found = false
	for _, obj in ipairs(Lighting:GetDescendants()) do
		if obj.ClassName == "ColorCorrectionEffect" or obj.ClassName == "ColorCorrection" then
			if string.find(tostring(obj.Name):lower(), "fiftykillstreak", 1, true) then
				found = true
				local ok, err = pcall(function() obj:Destroy() end)
				if not ok then warn("Failed to destroy ColorCorrection:", err) end
			end
		end
	end
	if not found then warn("No ColorCorrection with 'fiftykillstreak' found in Lighting.") end
end

local RemoveCCBtn = MakeButton("Remove50KSCC")
RemoveCCBtn.LayoutOrder = 5
RemoveCCBtn.BackgroundColor3 = Color3.fromRGB(80,80,120)
RemoveCCBtn.MouseButton1Click:Connect(removeFiftyKillCC)

--// GLOVE DISPLAY
local gloveDisplayEnabled = false
local gloveBillboards = {}
local gloveConnections = {}

-- Only these gloves are displayed.
-- Add/remove names to match your game's Glove leaderstat values.
local HEALTH_GLOVES = {
	["Overkill"] = true,
	["The Flex"] = true,
	["God"] = true,
	["Error"] = true,
	["Reaper"] = true,
	["Killstreak"] = true,
	["Detonator"] = true,
	["Tableflip"] = true,
	["Woah"] = true,
}

-- These displayed gloves are red.
local RED_GLOVES = {
	["Overkill"] = true,
	["The Flex"] = true,
	["God"] = true,
	["Error"] = true,
	["Reaper"] = true,
}

local function removeGloveDisplay(player)
	local gui = gloveBillboards[player]
	if gui then
		gui:Destroy()
		gloveBillboards[player] = nil
	end
end

local function disconnectGloveConnections(player)
	if gloveConnections[player] then
		for _, c in ipairs(gloveConnections[player]) do
			pcall(function() c:Disconnect() end)
		end
		gloveConnections[player] = nil
	end
end

local function getGloveValue(player)
	local stats = player:FindFirstChild("leaderstats")
	if not stats then return nil end
	return stats:FindFirstChild("Glove")
end

local function createGloveDisplay(player)
	if player == LocalPlayer or not gloveDisplayEnabled then
		removeGloveDisplay(player)
		return
	end

	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local glove = getGloveValue(player)

	if not head or not glove then
		removeGloveDisplay(player)
		return
	end

	local gloveName = tostring(glove.Value)

	-- Do not display non-health/void/power gloves.
	if not HEALTH_GLOVES[gloveName] then
		removeGloveDisplay(player)
		return
	end

	removeGloveDisplay(player)

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ClientGloveDisplay"
	billboard.Adornee = head
	billboard.Size = UDim2.fromOffset(180,40)
	billboard.StudsOffset = Vector3.new(0,2.8,0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 250
	billboard.Parent = head

	local scale = Instance.new("UIScale")
	scale.Name = "DistanceScale"
	scale.Scale = 1
	scale.Parent = billboard

	local label = Instance.new("TextLabel")
	label.Name = "GloveName"
	label.Size = UDim2.fromScale(1,1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = Color3.new(0,0,0)
	label.Text = gloveName
	label.TextColor3 = RED_GLOVES[gloveName]
		and Color3.fromRGB(255,60,60)
		or Color3.fromRGB(255,255,255)
	label.Parent = billboard

	gloveBillboards[player] = billboard
end

local function setupGlovePlayer(player)
	if player == LocalPlayer then return end

	disconnectGloveConnections(player)
	gloveConnections[player] = {}

	local function connectGlove(glove)
		if not glove then return end
		table.insert(gloveConnections[player], glove:GetPropertyChangedSignal("Value"):Connect(function()
			if gloveDisplayEnabled then createGloveDisplay(player) end
		end))
	end

	local stats = player:FindFirstChild("leaderstats")

	if stats then
		connectGlove(stats:FindFirstChild("Glove"))

		table.insert(gloveConnections[player], stats.ChildAdded:Connect(function(child)
			if child.Name == "Glove" then
				connectGlove(child)
				if gloveDisplayEnabled then
					task.defer(function() createGloveDisplay(player) end)
				end
			end
		end))
	else
		table.insert(gloveConnections[player], player.ChildAdded:Connect(function(child)
			if child.Name == "leaderstats" and gloveDisplayEnabled then
				task.wait(0.1)
				setupGlovePlayer(player)
				createGloveDisplay(player)
			end
		end))
	end

	table.insert(gloveConnections[player], player.CharacterAdded:Connect(function()
		if gloveDisplayEnabled then
			task.wait(0.35)
			createGloveDisplay(player)
		end
	end))

	if gloveDisplayEnabled then
		task.defer(function() createGloveDisplay(player) end)
	end
end

local function enableGloveDisplay()
	gloveDisplayEnabled = true
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			setupGlovePlayer(player)
			createGloveDisplay(player)
		end
	end
end

local function disableGloveDisplay()
	gloveDisplayEnabled = false
	for _, player in ipairs(Players:GetPlayers()) do
		removeGloveDisplay(player)
	end
end

Players.PlayerAdded:Connect(function(player)
	if player ~= LocalPlayer and gloveDisplayEnabled then
		setupGlovePlayer(player)
	end
end)

Players.PlayerRemoving:Connect(function(player)
	removeGloveDisplay(player)
	disconnectGloveConnections(player)
end)

-- Smooth distance scaling.
RunService.RenderStepped:Connect(function()
	if not gloveDisplayEnabled then return end

	local camera = workspace.CurrentCamera
	if not camera then return end

	for player, billboard in pairs(gloveBillboards) do
		if player ~= LocalPlayer and billboard and billboard.Parent then
			local character = player.Character
			local head = character and character:FindFirstChild("Head")

			if head then
				local distance = (camera.CFrame.Position - head.Position).Magnitude
				local scale = billboard:FindFirstChild("DistanceScale")

				if scale then
					-- 1.0 nearby, gradually smaller farther away.
					scale.Scale = math.clamp(25 / math.max(distance,1), 0.25, 1)
				end
			else
				removeGloveDisplay(player)
			end
		end
	end
end)

