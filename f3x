local function roundTo(value, snap)
    if not snap or snap <= 0 then return value end
    return math.round(value / snap) * snap
end

local function canSelect(part)
    if not part or not part:IsA("BasePart") then return false end
    local character = player.Character
    if character and part:IsDescendantOf(character) then return false end
    return true
end

local function destroyHandles()
    if handles then
        handles:Destroy()
        handles = nil
    end
end

local function updateStatus()
    if not statusLabel then return end
    local name = selected and selected.Name or "Nothing"
    statusLabel.Text = currentMode .. "  |  " .. name
end

local function faceVector(face)
    if face == Enum.NormalId.Right then return Vector3.new(1,0,0) end
    if face == Enum.NormalId.Left then return Vector3.new(-1,0,0) end
    if face == Enum.NormalId.Top then return Vector3.new(0,1,0) end
    if face == Enum.NormalId.Bottom then return Vector3.new(0,-1,0) end
    if face == Enum.NormalId.Back then return Vector3.new(0,0,1) end
    return Vector3.new(0,0,-1)
end

