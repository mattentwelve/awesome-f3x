local function paintPart(part)
    if not canSelect(part) then return end
    part.Color = paintColor
    for _, light in ipairs(part:GetChildren()) do
        if light:IsA("Light") and light.Name == "ClientBToolsLight" then
            light.Color = paintColor
        end
    end
    local emitter = part:FindFirstChild("ClientBToolsParticle")
    if emitter and emitter:IsA("ParticleEmitter") then
        emitter.Color = ColorSequence.new(paintColor)
    end
end

local function toggleParticle(part)
    if not canSelect(part) then return end

    local existing = part:FindFirstChild("ClientBToolsParticle")

    if existing and existing:IsA("ParticleEmitter")
        and existing:GetAttribute("Preset") == selectedParticle then
        existing:Destroy()
        return
    end

    if existing then
        existing:Destroy()
    end

    local preset = PARTICLE_PRESETS[selectedParticle]
    if not preset then return end

    local emitter = Instance.new("ParticleEmitter")
    emitter.Name = "ClientBToolsParticle"
    emitter:SetAttribute("Preset", selectedParticle)
    emitter.Texture = preset.Texture
    emitter.Rate = preset.Rate
    emitter.Lifetime = preset.Lifetime
    emitter.Speed = preset.Speed
    emitter.SpreadAngle = preset.SpreadAngle
    emitter.Acceleration = preset.Acceleration
    emitter.LightEmission = preset.LightEmission
    emitter.Rotation = NumberRange.new(0,360)
    emitter.RotSpeed = NumberRange.new(-90,90)
    emitter.Color = ColorSequence.new(paintColor)
    emitter.Parent = part
end

