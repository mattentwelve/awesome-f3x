local SAVE_FOLDER = "ClientBTools"
local SAVE_FILE = SAVE_FOLDER .. "/build.json"

local executorFileSupport =
    writefile and readfile and isfile and makefolder and isfolder

local function ensureSaveFolder()
    if not executorFileSupport then
        warn("Executor file APIs are unavailable.")
        return false
    end

    if not isfolder(SAVE_FOLDER) then
        makefolder(SAVE_FOLDER)
    end

    return true
end

-- Safe helpers
local function safeColorToTable(c)
    if typeof(c) == "Color3" then
        return {c.R, c.G, c.B}
    end
    return {paintColor.R, paintColor.G, paintColor.B}
end

local function safeNumberRangeToTable(nr)
    if typeof(nr) == "NumberRange" then
        return {nr.Min, nr.Max}
    end
    return {0,0}
end

local function safeVector2ToTable(v2)
    if typeof(v2) == "Vector2" then
        return {v2.X, v2.Y}
    end
    return {0,0}
end

local function safeVector3ToTable(v3)
    if typeof(v3) == "Vector3" then
        return {v3.X, v3.Y, v3.Z}
    end
    return {0,0,0}
end

-- Serialize a ParticleEmitter in a minimal, robust way
local function serializeParticle(emitter)
    if not emitter or not emitter:IsA("ParticleEmitter") then return nil end
    local ok, colorSeq = pcall(function() return emitter.Color end)
    local color = paintColor
    if ok and colorSeq and typeof(colorSeq) == "ColorSequence" then
        local kp = colorSeq.Keypoints and colorSeq.Keypoints[1]
        if kp and kp.Value then color = kp.Value end
    end

    return {
        Preset = emitter:GetAttribute("Preset") or "Custom",
        Color = safeColorToTable(color),
        Rate = tonumber(emitter.Rate) or 0,
        Lifetime = safeNumberRangeToTable(emitter.Lifetime),
        Speed = safeNumberRangeToTable(emitter.Speed),
        SpreadAngle = safeVector2ToTable(emitter.SpreadAngle),
        Acceleration = safeVector3ToTable(emitter.Acceleration),
        LightEmission = tonumber(emitter.LightEmission) or 0,
        Texture = tostring(emitter.Texture or ""),
    }
end

-- Serialize a Light in a minimal, robust way
local function serializeLight(light)
    if not light or not light:IsA("Light") then return nil end
    local t = {
        Class = light.ClassName,
        Color = safeColorToTable(light.Color or paintColor),
        Brightness = tonumber(light.Brightness) or 1,
        Range = tonumber(light.Range) or nil,
        Angle = tonumber(light.Angle) or nil,
        Face = (light.Face and light.Face.Name) or nil,
        Shadows = light.Shadows and true or false,
    }
    return t
end

local function serializePart(part)
    local particles = {}
    local lights = {}
    for _, child in ipairs(part:GetChildren()) do
        if child:IsA("ParticleEmitter") then
            local p = serializeParticle(child)
            if p then table.insert(particles, p) end
        elseif child:IsA("Light") then
            local l = serializeLight(child)
            if l then table.insert(lights, l) end
        end
    end

    return {
        Name = part.Name,
        Position = {part.Position.X, part.Position.Y, part.Position.Z},
        Rotation = {part.Orientation.X, part.Orientation.Y, part.Orientation.Z},
        Size = {part.Size.X, part.Size.Y, part.Size.Z},
        Color = {part.Color.R, part.Color.G, part.Color.B},
        Material = tostring(part.Material and part.Material.Name or "SmoothPlastic"),
        Transparency = tonumber(part.Transparency) or 0,
        Reflectance = tonumber(part.Reflectance) or 0,
        Anchored = part.Anchored and true or false,
        CanCollide = part.CanCollide and true or false,
        Particles = particles,
        Lights = lights,
    }
end

-- Atomic save: write to temp file then overwrite
local function saveBuild()
    if not ensureSaveFolder() then return end
    local build = {}
    for _, v in ipairs(workspace:GetChildren()) do
        if v:IsA("BasePart") and v.Name == "ClientPart" then
            table.insert(build, serializePart(v))
        end
    end

    local ok, encoded = pcall(function() return HttpService:JSONEncode(build) end)
    if not ok then
        warn("Failed to JSON encode build; aborting save.")
        return
    end

    local tmp = SAVE_FOLDER .. "/build.tmp"
    local success, err = pcall(function()
        writefile(tmp, encoded)
        if isfile(SAVE_FILE) then
            -- Overwrite existing file safely
            writefile(SAVE_FILE, readfile(tmp))
            pcall(function() delfile(tmp) end)
        else
            writefile(SAVE_FILE, readfile(tmp))
            pcall(function() delfile(tmp) end)
        end
    end)
    if not success then
        warn("Failed to write save file:", err)
        return
    end
    print("Saved", #build, "parts")
end

