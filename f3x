----------------------------------------------------------------
-- INPUT / TOOL EQUIP HANDLING
----------------------------------------------------------------

tool.Equipped:Connect(function()
    equipped = true
    createGui()
    updateStatus()
end)

tool.Unequipped:Connect(function()
    equipped = false
    destroyHandles()
    if gui then
        gui:Destroy()
        gui = nil
    end
    selectionBox.Visible = false
end)

mouse.Button1Down:Connect(function()
    if not equipped then return end
    local target = mouse.Target
    if not target then return end

    if currentMode == "Move" or currentMode == "Resize" or currentMode == "Rotate" then
        selectPart(target)
    elseif currentMode == "Make Part" then
        makePart(target, mouse.Hit.p)
    elseif currentMode == "Paint" then
        paintPart(target)
    elseif currentMode == "Particle" then
        toggleParticle(target)
    end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if not equipped then return end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        local key = input.KeyCode
        if key == Enum.KeyCode.Q then setMode("Move") end
        if key == Enum.KeyCode.E then setMode("Resize") end
        if key == Enum.KeyCode.R then setMode("Rotate") end
        if key == Enum.KeyCode.T then setMode("Make Part") end
        if key == Enum.KeyCode.P then setMode("Paint") end
        if key == Enum.KeyCode.G then setMode("Particle") end
        if key == Enum.KeyCode.F then
            if selected and selected.Parent then
                selected.Anchored = not selected.Anchored
            end
        end
        if key == Enum.KeyCode.Delete or key == Enum.KeyCode.Backspace then
            if selected and selected.Parent then
                local old = selected
                selected = nil
                refreshHandles()
                old:Destroy()
            end
        end
        if (key == Enum.KeyCode.D) and (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)) then
            if selected and selected.Parent then
                local clone = selected:Clone()
                clone.CFrame = selected.CFrame
                clone.Parent = selected.Parent
                selectPart(clone)
            end
        end
        if key == Enum.KeyCode.Escape then
            selected = nil
            refreshHandles()
        end
    end
end)

