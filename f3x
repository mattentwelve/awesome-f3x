local function makePart(target, hitPosition)
    if not target or not canSelect(target) then return end

    local normal = target.CFrame:VectorToWorldSpace(faceVector(mouse.TargetSurface))

    local part = Instance.new("Part")
    part.Name = "ClientPart"
    part.Size = Vector3.new(4,1,4)
    part.Anchored = true
    part.Material = selectedMaterial
    part.Transparency = selectedTransparency
    part.Reflectance = selectedReflectance
    part.Color = Color3.fromRGB(163,162,165)
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth

    local offset = normal * (0.5 + 0.02)
    part.CFrame = CFrame.new(hitPosition + offset)
    part.Parent = workspace

    selectPart(part)
end

