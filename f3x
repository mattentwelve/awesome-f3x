local function applySerializedLight(part, ldata)
    if not ldata then return end
    local cls = ldata.Class or "PointLight"
    local ok, light = pcall(function() return Instance.new(cls) end)
    if not ok or not light then return end
    light.Name = "ClientBToolsLight"
    light.Color = Color3.new(unpack(ldata.Color or {paintColor.R, paintColor.G, paintColor.B}))
    light.Brightness = ldata.Brightness or 2
    if light:IsA("PointLight") then
        light.Range = ldata.Range or 16
        light.Shadows = ldata.Shadows or false
    elseif light:IsA("SpotLight") then
        light.Range = ldata.Range or 24
        light.Angle = ldata.Angle or 70
        light.Face = Enum.NormalId[ldata.Face or "Front"]
        light.Shadows = ldata.Shadows or false
    elseif light:IsA("SurfaceLight") then
        light.Range = ldata.Range or 16
        light.Angle = ldata.Angle or 120
        light.Face = Enum.NormalId[ldata.Face or "Front"]
        light.Shadows = ldata.Shadows or false
    end
    light.Parent = part
end

local function loadBuild()
    if not ensureSaveFolder() or not isfile(SAVE_FILE) then return end

    local ok, data = pcall(function() return readfile(SAVE_FILE) end)
    if not ok or not data then
        warn("Failed to read save file; aborting load.")
        return
    end

    local decodedOk, decoded = pcall(function() return HttpService:JSONDecode(data) end)
    if not decodedOk or type(decoded) ~= "table" then
        warn("Save file is invalid JSON or not a table; aborting load.")
        return
    end

    -- JSON valid; now clear and recreate
    for _, v in ipairs(workspace:GetChildren()) do
        if v:IsA("BasePart") and v.Name == "ClientPart" then
            v:Destroy()
        end
    end

    for _, info in ipairs(decoded) do
        if type(info) == "table" and info.Size and info.Position and info.Rotation then
            local p = Instance.new("Part")
            p.Name = info.Name or "ClientPart"
            p.Size = Vector3.new(unpack(info.Size))
            p.CFrame =
                CFrame.new(unpack(info.Position))
                * CFrame.Angles(
                    math.rad(info.Rotation[1]),
                    math.rad(info.Rotation[2]),
                    math.rad(info.Rotation[3])
                )
            p.Color = Color3.new(unpack(info.Color or {0.5,0.5,0.5}))
            local m = Enum.Material[info.Material] or Enum.Material.SmoothPlastic
            p.Material = m
            p.Transparency = info.Transparency or 0
            p.Reflectance = info.Reflectance or 0
            p.Anchored = info.Anchored and true or false
            p.CanCollide = info.CanCollide and true or false
            p.TopSurface = Enum.SurfaceType.Smooth
            p.BottomSurface = Enum.SurfaceType.Smooth
            p.Parent = workspace

            if type(info.Particles) == "table" then
                for _, pdata in ipairs(info.Particles) do
                    applySerializedParticle(p, pdata)
                end
            end

            if type(info.Lights) == "table" then
                for _, ldata in ipairs(info.Lights) do
                    applySerializedLight(p, ldata)
                end
            end
        else
            warn("Skipping invalid part entry in save.")
        end
    end

    print("Loaded", #decoded, "parts")
end

