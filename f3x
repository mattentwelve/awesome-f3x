local function applyParticlePresetToPart(part, presetName, color)
    local preset = PARTICLE_PRESETS[presetName]
    if not preset then return end
    local emitter = Instance.new("ParticleEmitter")
    emitter.Name = "ClientBToolsParticle"
    emitter:SetAttribute("Preset", presetName)
    emitter.Texture = preset.Texture
    emitter.Rate = preset.Rate
    emitter.Lifetime = preset.Lifetime
    emitter.Speed = preset.Speed
    emitter.SpreadAngle = preset.SpreadAngle
    emitter.Acceleration = preset.Acceleration
    emitter.LightEmission = preset.LightEmission
    emitter.Rotation = NumberRange.new(0, 360)
    emitter.RotSpeed = NumberRange.new(-90, 90)
    emitter.Color = ColorSequence.new(color or paintColor)
    emitter.Parent = part
end

local function applySerializedParticle(part, pdata)
    if not pdata then return end
    if pdata.Preset and PARTICLE_PRESETS[pdata.Preset] then
        local color = pdata.Color and Color3.new(pdata.Color[1], pdata.Color[2], pdata.Color[3]) or paintColor
        applyParticlePresetToPart(part, pdata.Preset, color)
    else
        local emitter = Instance.new("ParticleEmitter")
        emitter.Name = "ClientBToolsParticle"
        emitter.Texture = pdata.Texture or "rbxasset://textures/particles/sparkles_main.dds"
        emitter.Rate = pdata.Rate or 10
        emitter.Lifetime = NumberRange.new((pdata.Lifetime and pdata.Lifetime[1]) or 1, (pdata.Lifetime and pdata.Lifetime[2]) or 2)
        emitter.Speed = NumberRange.new((pdata.Speed and pdata.Speed[1]) or 1, (pdata.Speed and pdata.Speed[2]) or 2)
        emitter.SpreadAngle = Vector2.new((pdata.SpreadAngle and pdata.SpreadAngle[1]) or 20, (pdata.SpreadAngle and pdata.SpreadAngle[2]) or 20)
        emitter.Acceleration = Vector3.new((pdata.Acceleration and pdata.Acceleration[1]) or 0, (pdata.Acceleration and pdata.Acceleration[2]) or 0, (pdata.Acceleration and pdata.Acceleration[3]) or 0)
        emitter.LightEmission = pdata.LightEmission or 0
        local color = pdata.Color and Color3.new(pdata.Color[1], pdata.Color[2], pdata.Color[3]) or paintColor
        emitter.Color = ColorSequence.new(color)
        emitter.Parent = part
    end
end
