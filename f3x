local function makeMoveHandles(part)
    local h = Instance.new("Handles")
    h.Style = Enum.HandlesStyle.Movement
    h.Adornee = part
    h.Parent = playerGui

    local startCFrame

    h.MouseButton1Down:Connect(function()
        if selected == part then startCFrame = part.CFrame end
    end)

    h.MouseDrag:Connect(function(face, distance)
        if selected ~= part or not startCFrame then return end
        distance = roundTo(distance, MOVE_SNAP)
        part.CFrame = startCFrame * CFrame.new(faceVector(face) * distance)
    end)

    return h
end

local function makeResizeHandles(part)
    local h = Instance.new("Handles")
    h.Style = Enum.HandlesStyle.Resize
    h.Adornee = part
    h.Parent = playerGui

    local startSize
    local startCFrame

    h.MouseButton1Down:Connect(function()
        if selected == part then
            startSize = part.Size
            startCFrame = part.CFrame
        end
    end)

    h.MouseDrag:Connect(function(face, distance)
        if selected ~= part or not startSize or not startCFrame then return end

        distance = roundTo(distance, RESIZE_SNAP)
        local dir = faceVector(face)
        local axis
        if math.abs(dir.X) == 1 then axis = "X"
        elseif math.abs(dir.Y) == 1 then axis = "Y"
        else axis = "Z" end

        local sign = axis == "X" and dir.X or axis == "Y" and dir.Y or dir.Z
        local targetSize = startSize
        local delta = distance

        if axis == "X" then
            local n = math.max(0.1, startSize.X + distance)
            delta = n - startSize.X
            targetSize = Vector3.new(n,startSize.Y,startSize.Z)
        elseif axis == "Y" then
            local n = math.max(0.1, startSize.Y + distance)
            delta = n - startSize.Y
            targetSize = Vector3.new(startSize.X,n,startSize.Z)
        else
            local n = math.max(0.1, startSize.Z + distance)
            delta = n - startSize.Z
            targetSize = Vector3.new(startSize.X,startSize.Y,n)
        end

        part.Size = targetSize
        local localDir =
            axis == "X" and Vector3.new(sign,0,0)
            or axis == "Y" and Vector3.new(0,sign,0)
            or Vector3.new(0,0,sign)

        part.CFrame = startCFrame * CFrame.new(localDir * (delta/2))
    end)

    return h
end

local function makeRotateHandles(part)
    local h = Instance.new("ArcHandles")
    h.Adornee = part
    h.Axes = Axes.new(Enum.Axis.X, Enum.Axis.Y, Enum.Axis.Z)
    h.Parent = playerGui

    local startCFrame

    h.MouseButton1Down:Connect(function()
        if selected == part then startCFrame = part.CFrame end
    end)

    h.MouseDrag:Connect(function(axis, relativeAngle)
        if selected ~= part or not startCFrame then return end

        local angle = math.rad(roundTo(math.deg(relativeAngle), ROTATE_SNAP))

        if axis == Enum.Axis.X then
            part.CFrame = startCFrame * CFrame.Angles(angle,0,0)
        elseif axis == Enum.Axis.Y then
            part.CFrame = startCFrame * CFrame.Angles(0,angle,0)
        else
            part.CFrame = startCFrame * CFrame.Angles(0,0,angle)
        end
    end)

    return h
end

local function refreshHandles()
    destroyHandles()

    if not equipped or not selected or not selected.Parent then
        selectionBox.Adornee = nil
        selectionBox.Visible = false
        updateStatus()
        return
    end

    selectionBox.Adornee = selected
    selectionBox.Visible = true

    if currentMode == "Move" then
        handles = makeMoveHandles(selected)
    elseif currentMode == "Resize" then
        handles = makeResizeHandles(selected)
    elseif currentMode == "Rotate" then
        handles = makeRotateHandles(selected)
    end

    updateStatus()
end

local function selectPart(part)
    selected = canSelect(part) and part or nil
    refreshHandles()
end

local function setMode(mode)
    currentMode = mode
    refreshHandles()
end

